<Window x:Class="RyoikiTenkai.Wpf.GestureActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gesture Actions" Width="900" Height="580"
        MinWidth="760" MinHeight="500" Background="{StaticResource Backdrop}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Close" Margin="0"
                    Style="{StaticResource QuietButton}" Click="CloseButton_Click" />
            <StackPanel>
                <TextBlock Text="Gesture Actions" Style="{StaticResource TitleText}" />
                <TextBlock Text="Pick a saved gesture, then choose what it should do when recognized."
                           Style="{StaticResource SubtitleText}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Reload" Margin="0"
                                Style="{StaticResource CompactQuietButton}"
                                ToolTip="Re-read definitions from the native repository"
                                Click="ReloadGestureDefinitionsButton_Click" />
                        <TextBlock Text="SAVED GESTURES" Style="{StaticResource SectionHeaderText}"
                                   Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="EmptyCatalogText" DockPanel.Dock="Bottom"
                               Text="No gestures yet. Use Register a Gesture on the main window."
                               Style="{StaticResource CaptionText}" Margin="2,10,2,0"
                               Visibility="Collapsed" />
                    <ListBox x:Name="SavedGesturesList" BorderThickness="1"
                             SelectionChanged="SavedGesturesList_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border x:Name="DetailPanel" Grid.Column="1" Margin="16,0,0,0"
                    Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="SelectedGestureTitleText" Text="No gesture selected"
                                   FontSize="19" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectedGestureFactsText" Text="Select a gesture on the left."
                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

                        <TextBlock Text="NAME" Style="{StaticResource SectionHeaderText}" Margin="0,20,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save name" Margin="8,0,0,0"
                                    Style="{StaticResource CompactButton}"
                                    Click="UpdateGestureDefinitionButton_Click" />
                            <TextBox x:Name="SelectedGestureNameText" ToolTip="1–63 UTF-8 bytes" />
                        </DockPanel>

                        <DockPanel Margin="0,12,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Review takes" Style="{StaticResource CompactQuietButton}"
                                        Click="ReviewGestureRecordingsButton_Click" />
                                <Button Content="Delete" Margin="0"
                                        Style="{StaticResource CompactButton}"
                                        Click="DeleteGestureDefinitionButton_Click" />
                            </StackPanel>
                            <CheckBox x:Name="SelectedGestureEnabledCheckBox" Content="Recognition enabled"
                                      Click="SelectedGestureEnabledCheckBox_Click" />
                        </DockPanel>

                        <Border Margin="0,20,0,0" Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="ACTION BINDING" Style="{StaticResource SectionHeaderText}"
                                           Margin="0" />
                                <TextBlock Text="What happens when this gesture is recognized."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />

                                <TextBlock Text="Action" Style="{StaticResource FieldLabelText}" Margin="0,14,0,4" />
                                <ComboBox x:Name="GestureActionTypeComboBox" SelectedIndex="0"
                                          SelectionChanged="GestureActionTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Keyboard shortcut" Tag="keyboard.hotkey" />
                                    <ComboBoxItem Content="Type text" Tag="keyboard.typeText" />
                                    <ComboBoxItem Content="Launch app or document" Tag="app.launch" />
                                    <ComboBoxItem Content="Offer screenshot over LAN" Tag="handoff.grab" />
                                    <ComboBoxItem Content="Receive latest LAN offer" Tag="handoff.release" />
                                </ComboBox>

                                <StackPanel x:Name="ActionParameterPanel">
                                    <TextBlock x:Name="ActionParameterLabel" Text="Value"
                                               Style="{StaticResource FieldLabelText}" Margin="0,14,0,4" />
                                    <TextBox x:Name="GestureActionParameterText" />
                                </StackPanel>
                                <TextBlock x:Name="ActionParameterHintText" Text="Example: CTRL+K"
                                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />

                                <DockPanel Margin="0,16,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Remove" Style="{StaticResource CompactQuietButton}"
                                                Click="RemoveGestureBindingButton_Click" />
                                        <Button Content="Save action" Margin="0"
                                                Style="{StaticResource AccentButton}"
                                                MinHeight="28" Padding="12,4" FontSize="12"
                                                Click="SaveGestureBindingButton_Click" />
                                    </StackPanel>
                                    <CheckBox x:Name="GestureBindingEnabledCheckBox" Content="Action enabled"
                                              IsChecked="True" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource StatusPill}"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0"
                         VerticalAlignment="Center" Fill="{StaticResource TextMuted}" />
                <TextBlock x:Name="GestureRepositoryStatusText" Text="Loading saved gestures…"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
