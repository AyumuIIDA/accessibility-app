<UserControl x:Class="RyoikiTenkai.Wpf.SkeletonVideoDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RyoikiTenkai.Wpf"
             Background="#101319">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="116" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#050608" BorderBrush="#303746" BorderThickness="1">
            <Grid>
                <local:SkeletonViewport x:Name="Viewport" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="10,7"
                        Background="#B0000000" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="ViewportTitleText" Text="No skeleton frames" Foreground="#F2F4F8"
                                   FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" />
                        <TextBlock x:Name="ViewportSubtitleText" Text="Start camera/perception to record skeleton video"
                                   Foreground="#AAB3C2" FontSize="12" TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Background="#171B22"
                BorderBrush="#303746" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Frame Inspector" Foreground="#F2F4F8" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="FrameFactsText" Text="-" Foreground="#AAB3C2" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,12,0,0" Background="#0F1115" BorderBrush="#2B313D"
                        BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Decision" Foreground="#AAB3C2" FontSize="12" />
                        <TextBlock x:Name="DecisionText" Text="-" Foreground="#F2F4F8" FontSize="15"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="ReasonText" Text="-" Foreground="#AAB3C2" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="ScoresList" Grid.Row="2" Margin="0,12,0,0" Background="#0F1115"
                         BorderBrush="#2B313D" Foreground="#E7EAF0" />

                <Border Grid.Row="3" Margin="0,12,0,0" Background="#0F1115" BorderBrush="#2B313D"
                        BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Recognizer 2s Window" Foreground="#AAB3C2" FontSize="12" />
                        <local:RecognizerWindowStrip x:Name="WindowStrip" Grid.Row="1" Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Background="#171B22"
                BorderBrush="#303746" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="|&lt;" Click="JumpStart_Click" MinWidth="38" Margin="0,0,6,0" />
                        <Button Content="&lt;" Click="StepBack_Click" MinWidth="38" Margin="0,0,6,0" />
                        <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPause_Click" MinWidth="58" Margin="0,0,6,0" />
                        <Button Content="&gt;" Click="StepForward_Click" MinWidth="38" Margin="0,0,6,0" />
                        <Button Content="&gt;|" Click="JumpEnd_Click" MinWidth="38" Margin="0,0,10,0" />
                        <Button Content="Prev Event" Click="PreviousEvent_Click" MinWidth="82" Margin="0,0,6,0" />
                        <Button Content="Next Event" Click="NextEvent_Click" MinWidth="82" Margin="0,0,10,0" />
                        <Button x:Name="LiveButton" Content="Live" Click="Live_Click" MinWidth="54" Margin="0,0,10,0" />
                        <ComboBox x:Name="SpeedCombo" Width="74" SelectionChanged="SpeedCombo_SelectionChanged">
                            <ComboBoxItem Content="0.25x" Tag="0.25" />
                            <ComboBoxItem Content="0.5x" Tag="0.5" />
                            <ComboBoxItem Content="1x" Tag="1" IsSelected="True" />
                            <ComboBoxItem Content="2x" Tag="2" />
                            <ComboBoxItem Content="4x" Tag="4" />
                        </ComboBox>
                        <TextBlock Text="Zoom" Foreground="#AAB3C2" VerticalAlignment="Center" Margin="14,0,6,0" />
                        <Slider x:Name="TimelineZoomSlider" Width="150" Minimum="1" Maximum="24" Value="2"
                                ValueChanged="TimelineZoomSlider_ValueChanged" />
                    </StackPanel>
                    <TextBlock x:Name="RecordingText" DockPanel.Dock="Right" Text="-" Foreground="#AAB3C2"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                </DockPanel>
                <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="1" Margin="0,8,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <local:SkeletonTimeline x:Name="Timeline" Height="78" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
