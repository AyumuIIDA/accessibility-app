<Window x:Class="RyoikiTenkai.Wpf.GestureDtwDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:native="clr-namespace:RyoikiTenkai.Wpf.Native"
        Title="Gesture DTW Debugger" Width="1040" Height="720"
        MinWidth="880" MinHeight="600" Background="#0F1115">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseButton_Click" />
            <StackPanel>
                <TextBlock Text="DTW Gesture Comparison" Foreground="#F2F4F8"
                           FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="Live and DTW-aligned hands are shown above; the path matrix and aligned motion curves are shown below."
                           Foreground="#9DA6B8" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#050608" BorderBrush="#303746"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DecisionText" Text="Waiting for a comparison"
                               Foreground="#8EC5FF" FontSize="20" FontWeight="Bold" />
                    <native:GestureDtwDebugViewportHost x:Name="DtwViewport"
                                                        Grid.Row="1" Margin="8,14,8,10"
                                                        MinHeight="380" />
                    <TextBlock Grid.Row="2" Text="Top: live candidate vs aligned template   Bottom: candidate/template DTW alignment"
                               Foreground="#9DA6B8" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#171B22" Padding="14" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Comparison" Foreground="#F2F4F8" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="FactsText" Text="-" Foreground="#C5CDDA"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                            <ProgressBar x:Name="ConfidenceBar" Minimum="0" Maximum="100"
                                         Height="14" Margin="0,12,0,0" />
                            <TextBlock x:Name="ReasonText" Text="No DTW attempt yet."
                                       Foreground="#FFB36A" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="#171B22" Padding="14" CornerRadius="8" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Distance contribution" Foreground="#F2F4F8"
                                       FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="BreakdownText" Margin="0,10,0,0"
                                       Foreground="#C5CDDA" FontFamily="Consolas"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#788294" TextWrapping="Wrap"
                   Text="The lower-left matrix shows the DTW path against equal timing. The lower-right curves show candidate and template palm velocity, with lines connecting the frame pairs selected by the actual multivariate DTW path." />
    </Grid>
</Window>
