<Window x:Class="RyoikiTenkai.Wpf.GestureDtwDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:native="clr-namespace:RyoikiTenkai.Wpf.Native"
        Title="Gesture DTW Debugger" Width="1120" Height="760"
        MinWidth="920" MinHeight="620" Background="{StaticResource Backdrop}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Close" Margin="0"
                    Style="{StaticResource QuietButton}" Click="CloseButton_Click" />
            <StackPanel>
                <TextBlock Text="DTW Gesture Comparison" Style="{StaticResource TitleText}" />
                <TextBlock Text="Whatever the recognizer compared most recently is shown here."
                           Style="{StaticResource SubtitleText}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Which gesture this comparison is against, stated before anything
                     else: the visualization is meaningless without it. -->
                <Border Style="{StaticResource Card}" Padding="16,13">
                    <DockPanel>
                        <Border x:Name="DecisionBadge" DockPanel.Dock="Right" CornerRadius="14"
                                Padding="12,5" Background="{StaticResource SurfaceRaised}"
                                BorderBrush="{StaticResource Divider}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="DecisionText" Text="WAITING"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="COMPARED AGAINST" Style="{StaticResource SectionHeaderText}"
                                       Margin="0,0,0,3" />
                            <TextBlock x:Name="GestureNameText" Text="No comparison yet"
                                       FontSize="21" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="GestureSubText" Text="Perform a registered gesture in front of the camera."
                                       Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ViewportFrame}" Margin="0,14,0,0" Padding="14">
                    <native:GestureDtwDebugViewportHost x:Name="DtwViewport" MinHeight="340" />
                </Border>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Top · live candidate vs aligned template"
                               Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="Bottom · DTW path matrix and aligned palm velocity"
                               Style="{StaticResource CaptionText}" TextAlignment="Right" />
                </Grid>
            </Grid>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MATCH" Style="{StaticResource SectionHeaderText}" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock x:Name="ConfidenceValueText" DockPanel.Dock="Right"
                                           Text="—" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Confidence" Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            </DockPanel>
                            <ProgressBar x:Name="ConfidenceBar" Minimum="0" Maximum="100"
                                         Height="8" Margin="0,8,0,0" />
                            <TextBlock x:Name="ThresholdText" Text="threshold —"
                                       Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                            <Border Margin="0,12,0,0" Style="{StaticResource InsetCard}" Padding="11">
                                <TextBlock x:Name="ReasonText" Text="No DTW attempt yet."
                                           Foreground="{StaticResource Warning}" FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="COMPARISON FACTS" Style="{StaticResource SectionHeaderText}" />
                            <ItemsControl x:Name="FactsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding Value}" DockPanel.Dock="Right"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="DISTANCE CONTRIBUTION" Style="{StaticResource SectionHeaderText}" />
                            <TextBlock Text="Longest bar is the term rejecting the match."
                                       Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                            <ItemsControl x:Name="BreakdownList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" MinWidth="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Height="7" CornerRadius="4"
                                                    Background="{StaticResource SurfaceSunken}" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" CornerRadius="4"
                                                        Background="{Binding Fill}"
                                                        Width="{Binding BarWidth}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="11" Foreground="{StaticResource TextPrimary}"
                                                       TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
