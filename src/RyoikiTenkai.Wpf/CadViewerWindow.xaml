<Window x:Class="RyoikiTenkai.Wpf.CadViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:native="clr-namespace:RyoikiTenkai.Wpf.Native"
        Title="RyoikiTenkai 3D Viewer" Width="980" Height="700"
        MinWidth="640" MinHeight="480" Background="#0F1115">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Presentation" Foreground="#9DA6B8"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="PresentationModeComboBox" Width="112"
                          SelectedIndex="0"
                          SelectionChanged="PresentationModeComboBox_SelectionChanged"
                          Margin="0,0,14,0">
                    <ComboBoxItem Content="Mirror Direct" />
                    <ComboBoxItem Content="Physical" />
                </ComboBox>
                <TextBlock Text="Rotation" Foreground="#9DA6B8"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="RotationSensitivitySlider" Width="120"
                        Minimum="0.25" Maximum="2.0" Value="1.0"
                        TickFrequency="0.25" IsSnapToTickEnabled="False"
                        ValueChanged="RotationSensitivitySlider_ValueChanged"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="RotationSensitivityText" Text="1.00x"
                           Foreground="#E7EAF0" Width="46"
                           VerticalAlignment="Center" Margin="7,0,14,0" />
                <CheckBox x:Name="GestureEnabledCheckBox" Content="Hand control"
                          IsChecked="True" Foreground="#E7EAF0" VerticalAlignment="Center"
                          Margin="0,0,14,0" />
                <Button Content="Reset View" Click="ResetViewButton_Click" Padding="14,6" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="CAD-Style 3D Viewer" Foreground="#E7EAF0"
                           FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Space: rotate  |  Shift+Space: pan  |  Ctrl+Space: zoom"
                           Foreground="#9DA6B8" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#2B313D"
                BorderThickness="1" CornerRadius="6" Background="#090C11" ClipToBounds="True">
            <native:CadViewportHost x:Name="CadViewport" />
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#171B22" Padding="10" Margin="0,0,8,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Hand State" Foreground="#9DA6B8" />
                    <TextBlock x:Name="InteractionStateText" Text="NO HAND" Foreground="#E7EAF0"
                               FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Native-only perception and rendering"
                               Foreground="#AEEFFF" FontSize="13" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#171B22" Padding="10" Margin="0,0,8,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Zoom / Pan" Foreground="#9DA6B8" />
                    <TextBlock x:Name="ZoomText" Text="1.00x" Foreground="#E7EAF0" FontSize="18" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#171B22" Padding="10" Margin="0,0,8,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="3D Pose Delta" Foreground="#9DA6B8" />
                    <TextBlock x:Name="NormalAngleText" Text="Y 0.0 deg / P 0.0 deg" Foreground="#E7EAF0" FontSize="16" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#171B22" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Next Action" Foreground="#9DA6B8" />
                    <TextBlock x:Name="InstructionText" Text="Hold Space to rotate" Foreground="#E7EAF0" FontSize="16" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
