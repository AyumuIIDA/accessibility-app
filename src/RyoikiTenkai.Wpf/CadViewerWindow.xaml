<Window x:Class="RyoikiTenkai.Wpf.CadViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:native="clr-namespace:RyoikiTenkai.Wpf.Native"
        Title="RyoikiTenkai 3D Viewer" Width="1020" Height="720"
        MinWidth="720" MinHeight="520" Background="{StaticResource Backdrop}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Reset view" Margin="0" Style="{StaticResource QuietButton}"
                        Click="ResetViewButton_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CAD-Style 3D Viewer" Style="{StaticResource TitleText}" />
                <TextBlock Text="Space: rotate  ·  Shift+Space: pan  ·  Ctrl+Space: zoom"
                           Style="{StaticResource SubtitleText}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource ViewportFrame}">
            <native:CadViewportHost x:Name="CadViewport" />
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Input settings grouped away from read-only telemetry: they were
                 previously interleaved in one toolbar and read as one row. -->
            <Border Style="{StaticResource Card}" Padding="14,11">
                <DockPanel>
                    <CheckBox x:Name="GestureEnabledCheckBox" Content="Hand control"
                              IsChecked="True" DockPanel.Dock="Left" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="Presentation" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="PresentationModeComboBox" Width="132" SelectedIndex="0"
                                  SelectionChanged="PresentationModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Mirror Direct" />
                            <ComboBoxItem Content="Physical" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Rotation" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="RotationSensitivitySlider" Width="150"
                                Minimum="0.25" Maximum="2.0" Value="1.0"
                                TickFrequency="0.25" IsSnapToTickEnabled="False"
                                ValueChanged="RotationSensitivitySlider_ValueChanged"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="RotationSensitivityText" Text="1.00x" MinWidth="46"
                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="13,10" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="HAND STATE" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="InteractionStateText" Text="NO HAND"
                                   Style="{StaticResource MetricText}" />
                        <TextBlock Text="Native-only perception and rendering"
                                   Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="13,10" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ZOOM / PAN" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="ZoomText" Text="1.00x" Style="{StaticResource MetricText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="13,10" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="3D POSE DELTA" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="NormalAngleText" Text="Y 0.0° / P 0.0°"
                                   Style="{StaticResource MetricText}" FontSize="16" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="13,10">
                    <StackPanel>
                        <TextBlock Text="NEXT ACTION" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="InstructionText" Text="Hold Space to rotate"
                                   Style="{StaticResource MetricText}" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
