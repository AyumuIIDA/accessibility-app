<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeRuntimeSourceDir>$(MSBuildProjectDirectory)\..\RyoikiTenkai.Native</NativeRuntimeSourceDir>
    <NativeRuntimeBuildDir>$(MSBuildProjectDirectory)\..\..\build\RyoikiTenkai.Native.OpenCv</NativeRuntimeBuildDir>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == ''">$(VCPKG_ROOT)</VcpkgRoot>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == '' and '$(VSINSTALLDIR)' != ''">$(VSINSTALLDIR)VC\vcpkg</VcpkgRoot>
    <VcpkgTriplet Condition="'$(VcpkgTriplet)' == ''">arm64-windows-static-md</VcpkgTriplet>
    <VcpkgCMakeArgs Condition="'$(VcpkgRoot)' != '' and !Exists('$(NativeRuntimeBuildDir)\CMakeCache.txt')">-DCMAKE_TOOLCHAIN_FILE=&quot;$(VcpkgRoot)\scripts\buildsystems\vcpkg.cmake&quot; -DVCPKG_TARGET_TRIPLET=$(VcpkgTriplet)</VcpkgCMakeArgs>
    <QnnCMakeArgs Condition="'$(QnnRuntimeDir)' != '' and !Exists('$(NativeRuntimeBuildDir)\CMakeCache.txt')">-DQNN_RUNTIME_DIR=&quot;$(QnnRuntimeDir)&quot;</QnnCMakeArgs>
    <BuildNativeRuntime Condition="'$(BuildNativeRuntime)' == ''">false</BuildNativeRuntime>
    <SignNativeRuntime Condition="'$(SignNativeRuntime)' == ''">true</SignNativeRuntime>
    <NativeCodeSigningSubject Condition="'$(NativeCodeSigningSubject)' == ''">RyoikiTenkai Local Dev Code Signing</NativeCodeSigningSubject>
    <SignToolPath Condition="'$(SignToolPath)' == '' and Exists('C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\arm64\signtool.exe')">C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\arm64\signtool.exe</SignToolPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RyoikiTenkai\RyoikiTenkai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\RyoikiTenkai\models\**\*">
      <Link>models\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildNativeRuntimeWithCMake"
          BeforeTargets="Build"
          Condition="'$(BuildNativeRuntime)' == 'true'">
    <Error Condition="'$(VSCMD_ARG_TGT_ARCH)' != 'arm64'"
           Text="BuildNativeRuntime=true requires an ARM64 Visual Studio developer shell (VSCMD_ARG_TGT_ARCH=arm64)." />
    <Error Condition="'$(VcpkgRoot)' == ''"
           Text="BuildNativeRuntime=true requires VCPKG_ROOT or a Visual Studio installation with bundled vcpkg." />
    <Error Condition="!Exists('$(VcpkgRoot)\scripts\buildsystems\vcpkg.cmake')"
           Text="The vcpkg CMake toolchain was not found at '$(VcpkgRoot)\scripts\buildsystems\vcpkg.cmake'." />
    <Exec Command="cmake -S &quot;$(NativeRuntimeSourceDir)&quot; -B &quot;$(NativeRuntimeBuildDir)&quot; -G Ninja -DCMAKE_BUILD_TYPE=$(Configuration) $(VcpkgCMakeArgs) $(QnnCMakeArgs)" />
    <Exec Command="cmake --build &quot;$(NativeRuntimeBuildDir)&quot;" />
  </Target>

  <Target Name="CopyNativeRuntime"
          AfterTargets="Build"
          Condition="Exists('$(NativeRuntimeBuildDir)\RyoikiTenkai.Native.dll')">
    <ItemGroup>
      <NativeRuntimeFiles Include="$(NativeRuntimeBuildDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="SignCopiedNativeRuntime"
          AfterTargets="CopyNativeRuntime"
          Condition="'$(SignNativeRuntime)' == 'true' and '$(SignToolPath)' != '' and Exists('$(OutDir)RyoikiTenkai.Native.dll')">
    <Exec Command="&quot;$(SignToolPath)&quot; sign /fd SHA256 /n &quot;$(NativeCodeSigningSubject)&quot; &quot;$(OutDir)RyoikiTenkai.Native.dll&quot;" />
  </Target>

</Project>
