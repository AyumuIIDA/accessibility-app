<Window x:Class="RyoikiTenkai.Wpf.HandoffEffectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" IsHitTestVisible="False" Focusable="False"
        Title="RyoikiTenkai handoff effect">
    <Grid x:Name="Root" ClipToBounds="True" Opacity="0">
        <!-- Edge glow: reads as "the whole screen is doing something" without
             hiding the native preview underneath. -->
        <Border x:Name="EdgeGlow" BorderThickness="3" CornerRadius="12"
                BorderBrush="{StaticResource Accent}" Opacity="0.9">
            <Border.Effect>
                <BlurEffect Radius="6" />
            </Border.Effect>
        </Border>
        <Border BorderThickness="1" CornerRadius="12" x:Name="EdgeLine"
                BorderBrush="{StaticResource Accent}" Opacity="0.55" />

        <!-- Expanding (grab) or contracting (release) ring. -->
        <Ellipse x:Name="Ring" Width="240" Height="240" StrokeThickness="2"
                 Stroke="{StaticResource Accent}" Opacity="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="RingTrail" Width="240" Height="240" StrokeThickness="1"
                 Stroke="{StaticResource Accent}" Opacity="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RingTrailScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Border x:Name="Badge" VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="24" Padding="26,14" Background="{StaticResource OverlayScrim}"
                BorderBrush="{StaticResource Accent}" BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BadgeScale" ScaleX="0.92" ScaleY="0.92" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <!-- A completed transfer shows the payload itself: the gesture
                     gives no other confirmation of what actually moved. -->
                <Border x:Name="BadgeThumbnailFrame" Visibility="Collapsed"
                        Width="112" Height="72" CornerRadius="8" Margin="0,0,16,0"
                        Background="{StaticResource SurfaceSunken}"
                        BorderBrush="{StaticResource DividerStrong}" BorderThickness="1">
                    <Border x:Name="BadgeThumbnail" CornerRadius="7" Margin="1" />
                </Border>
                <TextBlock x:Name="BadgeGlyph" Text="⇪" FontSize="21" Margin="0,0,12,0"
                           VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                <StackPanel VerticalAlignment="Center" MaxWidth="360">
                    <TextBlock x:Name="BadgeTitle" Text="Offering over LAN"
                               FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BadgeDetail" Text="" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
