<Window x:Class="RyoikiTenkai.Wpf.GestureRecordingPlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:native="clr-namespace:RyoikiTenkai.Wpf.Native"
        Title="Gesture Recording Review" Width="1120" Height="760"
        MinWidth="900" MinHeight="620" Background="{StaticResource Backdrop}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Close" Margin="0"
                    Style="{StaticResource QuietButton}" Click="CloseButton_Click" />
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Recorded takes" Style="{StaticResource TitleText}" />
                <TextBlock Text="Skeleton playback stays in the native GPU renderer."
                           Style="{StaticResource SubtitleText}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="TAKES" Style="{StaticResource SectionHeaderText}" />
                    <ListBox x:Name="TakesList" Grid.Row="1" Margin="0,4,0,14"
                             SelectionChanged="TakesList_SelectionChanged" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TakeFactsText" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="PlaybackErrorText" Foreground="{StaticResource Danger}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="Export selected take…" Margin="0"
                                Style="{StaticResource QuietButton}" Click="ExportButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource ViewportFrame}">
                <native:GestureRecordingPlaybackHost x:Name="PlaybackHost" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton" Content="Play" MinWidth="88" Margin="0"
                        Style="{StaticResource AccentButton}" Click="PlayPauseButton_Click" />
                <Slider x:Name="PlaybackSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="16,0"
                        VerticalAlignment="Center" ValueChanged="PlaybackSlider_ValueChanged" />
                <TextBlock x:Name="PlaybackPositionText" Grid.Column="2" Text="0.0 / 0.0 s"
                           Foreground="{StaticResource TextSecondary}" MinWidth="86"
                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                           VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
