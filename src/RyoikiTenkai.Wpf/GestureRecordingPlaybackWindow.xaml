<Window x:Class="RyoikiTenkai.Wpf.GestureRecordingPlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:native="clr-namespace:RyoikiTenkai.Wpf.Native"
        Title="Gesture Recording Review" Width="1120" Height="760"
        MinWidth="900" MinHeight="620" Background="#0F1115">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseButton_Click" Padding="14,6"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Recorded takes" Foreground="#F2F4F8" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Skeleton playback stays in the native GPU renderer." Foreground="#9DA6B8"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#171B22" Padding="14" CornerRadius="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Takes" Foreground="#F2F4F8" FontSize="18" FontWeight="SemiBold"/>
                    <ListBox x:Name="TakesList" Grid.Row="1" Margin="0,8,0,12" Background="#101319" Foreground="#E7EAF0"
                             SelectionChanged="TakesList_SelectionChanged"/>
                    <TextBlock x:Name="TakeFactsText" Grid.Row="2" Foreground="#C5CDDA" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="3">
                        <TextBlock x:Name="PlaybackErrorText" Foreground="#FF9D7A" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Export Selected Take…" Click="ExportButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="14,0,0,0" Background="#050608" BorderBrush="#303746" BorderThickness="1" CornerRadius="8">
                <native:GestureRecordingPlaybackHost x:Name="PlaybackHost"/>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPauseButton_Click" MinWidth="82"/>
            <Slider x:Name="PlaybackSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="12,0"
                    ValueChanged="PlaybackSlider_ValueChanged"/>
            <TextBlock x:Name="PlaybackPositionText" Grid.Column="2" Text="0.0 / 0.0 s" Foreground="#C5CDDA"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
