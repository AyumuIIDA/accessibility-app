<Window x:Class="RyoikiTenkai.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:native="clr-namespace:RyoikiTenkai.Wpf.Native"
        Title="RyoikiTenkai" Height="780" Width="1180"
        MinHeight="680" MinWidth="960" Background="{StaticResource Backdrop}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: identity on the left, camera control on the right, and the
             two passive status lines that must stay readable at a glance. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenGestureActionsButton" Content="Gesture Actions"
                        Style="{StaticResource QuietButton}"
                        Click="OpenGestureActionsButton_Click" />
                <Button x:Name="OpenCadViewerButton" Content="3D Viewer"
                        Style="{StaticResource QuietButton}"
                        Click="OpenCadViewerButton_Click" />
                <Button x:Name="OpenGestureRegistrationButton" Content="Register a Gesture"
                        Click="EnterGestureRegistrationModeButton_Click" />
                <Button x:Name="StartButton" Content="Start Camera"
                        Style="{StaticResource AccentButton}" Click="StartButton_Click" />
                <Button x:Name="StopButton" Content="Stop" Margin="0"
                        Style="{StaticResource DangerQuietButton}"
                        Click="StopButton_Click" IsEnabled="False" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RyoikiTenkai" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Real-time hand perception" Style="{StaticResource SubtitleText}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse x:Name="HandoffStatusDot" Width="7" Height="7" VerticalAlignment="Center"
                             Margin="0,0,7,0" Fill="{StaticResource TextMuted}" />
                    <TextBlock x:Name="HandoffStatusText" Text="LAN handoff idle · waiting for offers"
                               Foreground="{StaticResource TextMuted}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RegistrationColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ViewportFrame}">
                <Grid x:Name="PreviewHost" ClipToBounds="True">
                    <native:NativeVisionHost x:Name="NativeVisionHostControl" Visibility="Collapsed" />
                    <!-- Shown until the native runtime starts; WPF content cannot
                         reliably overlay the HwndHost once it is visible. -->
                    <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Camera is off" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Start the camera to see hand perception, register gestures, and run LAN handoff."
                                   Style="{StaticResource CaptionText}" MaxWidth="360"
                                   TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Keep registration controls beside HwndHost. WPF content cannot reliably overlay it. -->
            <Border x:Name="RegistrationPanel" Grid.Column="1" Visibility="Collapsed"
                    Margin="18,0,0,0" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="✕" Margin="0"
                                Style="{StaticResource CompactQuietButton}" Padding="9,4"
                                ToolTip="Close gesture registration"
                                Click="ExitGestureRegistrationModeButton_Click" />
                        <StackPanel>
                            <TextBlock Text="Register a Gesture" Style="{StaticResource TitleText}" FontSize="21" />
                            <TextBlock Text="Record the same movement three times."
                                       Style="{StaticResource SubtitleText}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <TextBlock Text="NEW GESTURE NAME" Style="{StaticResource SectionHeaderText}" />
                        <TextBox x:Name="GestureNameText" Text="My gesture" />
                        <!-- Saved gestures and their action bindings live in their own window;
                             this panel has to stay readable beside the native preview. -->
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Manage…" Margin="0"
                                    Style="{StaticResource CompactQuietButton}"
                                    ToolTip="Open saved gestures and action bindings"
                                    Click="OpenGestureActionsButton_Click" />
                            <TextBlock x:Name="GestureCatalogSummaryText" Text="Loading saved gestures…"
                                       Foreground="{StaticResource TextMuted}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="0,18,0,18" Style="{StaticResource InsetCard}" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel VerticalAlignment="Center" Margin="0,4">
                                <TextBlock x:Name="RecordingTrialText" Text="TRIAL 1 OF 3"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" FontWeight="SemiBold" />
                                <ProgressBar x:Name="AcceptedTrialsProgress" Minimum="0" Maximum="3"
                                             Value="0" Height="5" Margin="24,10,24,16" />
                                <TextBlock x:Name="RecordingPhaseText" Text="SHOW ONE HAND"
                                           HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource Info}" />
                                <TextBlock x:Name="RecordingClockText" Text=""
                                           HorizontalAlignment="Center" Margin="0,10,0,0"
                                           FontSize="44" FontWeight="SemiBold"
                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                                <ProgressBar x:Name="RecordingProgressBar" Minimum="0" Maximum="2.5"
                                             Value="0" Height="8" Margin="0,16,0,16" />
                                <TextBlock x:Name="RecordingInstructionText"
                                           Text="Keep only the hand you want to record in view. Recording is available when one hand is stable."
                                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock x:Name="RecordingQualityText" Text=""
                                           Foreground="{StaticResource Warning}" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />

                                <Border x:Name="GestureValidationPanel" Visibility="Collapsed"
                                        Margin="0,18,0,0" Style="{StaticResource Card}" Padding="14"
                                        Background="{StaticResource SurfaceRaised}">
                                    <StackPanel>
                                        <TextBlock x:Name="ValidationPromptText" Text="Perform the gesture again"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="12"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ValidationResultText" Text="WATCHING"
                                                   Margin="0,10,0,0" HorizontalAlignment="Center"
                                                   FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource Info}" />
                                        <ProgressBar x:Name="ValidationConfidenceBar" Minimum="0" Maximum="100"
                                                     Value="0" Height="10" Margin="0,12,0,0" />
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock Text="Match" Foreground="{StaticResource TextMuted}"
                                                       FontSize="12" />
                                            <TextBlock x:Name="ValidationConfidenceText" Text="0%"
                                                       DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="12" />
                                        </DockPanel>
                                        <ProgressBar x:Name="ValidationWindowBar" Minimum="0" Maximum="2500"
                                                     Value="0" Height="4" Margin="0,12,0,0" />
                                        <DockPanel Margin="0,5,0,0">
                                            <TextBlock x:Name="ValidationWindowText" Text="Motion window: waiting"
                                                       Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <TextBlock Text="threshold 82%" DockPanel.Dock="Right"
                                                       Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        </DockPanel>
                                        <TextBlock x:Name="ValidationReasonText"
                                                   Text="Move the registered hand naturally."
                                                   Foreground="{StaticResource TextSecondary}" FontSize="12"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <Button Content="Open DTW Debugger" Margin="0,14,0,0"
                                                Style="{StaticResource CompactQuietButton}"
                                                Click="OpenDtwDebuggerButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartGestureRecordingButton" Grid.Column="0"
                                Content="Start Trial 1" Style="{StaticResource SuccessButton}"
                                Click="BeginExplicitGestureRecordingButton_Click" />
                        <Button x:Name="StopGestureRecordingButton" Grid.Column="0"
                                Content="Stop &amp; Save" Style="{StaticResource DangerButton}"
                                Visibility="Collapsed"
                                Click="FinishExplicitGestureRecordingButton_Click" />
                        <Button x:Name="CancelGestureRecordingButton" Grid.Column="1" Margin="0"
                                Content="Cancel" Style="{StaticResource QuietButton}"
                                Click="CancelExplicitGestureRecordingButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="CameraStatusDot" Width="8" Height="8" VerticalAlignment="Center"
                         Margin="0,0,9,0" Fill="{StaticResource TextMuted}" />
                <TextBlock x:Name="StateText" Text="Camera stopped" FontSize="14"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Receipt for the last completed transfer. The effect is transient
                 and the gesture gives no confirmation, so what was sent or
                 received stays visible here until the next transfer. -->
            <Border x:Name="LastTransferCard" Grid.Column="1" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="460"
                    Margin="20,0,16,0" Padding="8,7" CornerRadius="10"
                    Background="{StaticResource Surface}" BorderThickness="1"
                    BorderBrush="{StaticResource Divider}"
                    MouseLeftButtonUp="LastTransferCard_MouseLeftButtonUp">
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="34" CornerRadius="6" Margin="0,0,11,0"
                            Background="{StaticResource SurfaceSunken}" BorderThickness="1"
                            BorderBrush="{StaticResource Divider}">
                        <Grid>
                            <TextBlock x:Name="LastTransferThumbnailFallback" Text="▤" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}" />
                            <Border x:Name="LastTransferThumbnail" CornerRadius="5" Margin="1" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LastTransferGlyph" Text="↑" FontSize="12"
                                       FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="LastTransferHeadline" Text="" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="LastTransferDetail" Text="" Margin="0,2,0,0"
                                   Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatusPill}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Inference" Foreground="{StaticResource TextMuted}"
                               FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="InferenceTimeText" Text="—" FontWeight="SemiBold"
                               FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
