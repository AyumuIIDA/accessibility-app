<Window x:Class="RyoikiTenkai.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RyoikiTenkai.Wpf"
        xmlns:native="clr-namespace:RyoikiTenkai.Wpf.Native"
        Title="RyoikiTenkai" Height="780" Width="1320"
        MinHeight="720" MinWidth="1160"
        Background="#0F1115">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7EAF0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="92" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="UseNativeRuntimeCheckBox"
                              Content="Native runtime"
                              IsChecked="True"
                              Foreground="#E7EAF0"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="RyoikiTenkai" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Camera -> palm bbox -> hand landmarks -> gesture -> PC action"
                               Foreground="#9DA6B8" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="#050608" BorderBrush="#2B313D" BorderThickness="1" CornerRadius="8">
                <Grid x:Name="PreviewHost" ClipToBounds="True">
                    <Image x:Name="CameraImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Image.RenderTransform>
                    </Image>
                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Canvas.RenderTransform>
                    </Canvas>
                    <native:NativeVisionHost x:Name="NativeVisionHostControl" Visibility="Collapsed" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                            Padding="10,6" Background="#B0000000" CornerRadius="4">
                        <TextBlock x:Name="OverlayStatusText" Text="Stopped" FontSize="15" MaxWidth="520" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#171B22" Padding="12" Margin="0,0,8,0" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Gesture" Foreground="#9DA6B8" />
                        <TextBlock x:Name="GestureText" Text="-" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#171B22" Padding="12" Margin="0,0,8,0" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Confidence" Foreground="#9DA6B8" />
                        <TextBlock x:Name="ConfidenceText" Text="-" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#171B22" Padding="12" Margin="0,0,8,0" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Latency" Foreground="#9DA6B8" />
                        <TextBlock x:Name="LatencyText" Text="-" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#171B22" Padding="12" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Runtime" Foreground="#9DA6B8" />
                        <TextBlock x:Name="RuntimeProviderText" Text="Native NPU" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="260" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#171B22" Padding="14" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Execution State" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StateText" Text="Idle" Margin="0,8,0,0" FontSize="16" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="RuntimeModeText" Text="Recorded custom gestures only" Foreground="#9DA6B8" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#171B22" Padding="14" Margin="0,12,0,0" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Gestures" FontSize="18" FontWeight="SemiBold" />
                    <ListBox x:Name="GesturesList" Grid.Row="1" Margin="0,8,0,10" Background="#0F1115" Foreground="#E7EAF0" SelectionChanged="GesturesList_SelectionChanged" />
                    <StackPanel Grid.Row="2">
                        <TextBox x:Name="GestureNameText" Text="wave" />
                        <ProgressBar x:Name="RecordingProgressBar" Minimum="0" Maximum="100" Height="12" Value="0" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RecordGestureButton" Content="Record 3 Examples" Click="RecordGestureButton_Click" />
                            <Button x:Name="DeleteGestureButton" Content="Delete" Click="DeleteGestureButton_Click" />
                            <Button x:Name="FlushGesturesButton" Content="Flush All" Click="FlushGesturesButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="RecordingCounterText" Text="Takes 0/3" Foreground="#E7EAF0" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RecordingWindowText" Text="Idle" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock x:Name="RecordingStatusText" Text="Custom gestures need 3 accepted takes." Foreground="#9DA6B8" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Height="22" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="2" Margin="0,12,0,0" Background="#171B22" Foreground="#E7EAF0">
                <TabItem Header="Actions">
                    <Grid Background="#171B22" Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="118" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Bindings" FontSize="18" FontWeight="SemiBold" />
                        <ListBox x:Name="BindingsList" Grid.Row="1" Margin="0,8,0,12" Background="#0F1115" Foreground="#E7EAF0" />

                        <TextBlock Grid.Row="2" Text="Action Log" FontSize="18" FontWeight="SemiBold" />
                        <ListBox x:Name="ActionLogList" Grid.Row="3" Margin="0,8,0,12" Background="#0F1115" Foreground="#E7EAF0" />

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Register Action" FontSize="18" FontWeight="SemiBold" />

                            <TextBlock Text="Gesture" Foreground="#9DA6B8" Margin="0,12,0,0" />
                            <ComboBox x:Name="GestureCombo">
                            </ComboBox>

                            <TextBlock Text="Action" Foreground="#9DA6B8" />
                            <ComboBox x:Name="ActionTypeCombo" SelectionChanged="ActionTypeCombo_SelectionChanged">
                                <ComboBoxItem Content="Launch app" IsSelected="True" Tag="app.launch" />
                                <ComboBoxItem Content="Hotkey" Tag="keyboard.hotkey" />
                                <ComboBoxItem Content="Type text" Tag="keyboard.typeText" />
                            </ComboBox>

                            <TextBlock x:Name="ActionValueLabel" Text="Path" Foreground="#9DA6B8" />
                            <TextBox x:Name="ActionValueText" Text="notepad.exe" />

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveBindingButton" Content="Save Binding" Click="SaveBindingButton_Click" />
                                <Button x:Name="ClearBindingsButton" Content="Clear Bindings" Click="ResetSampleButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Debug Lab">
                    <Grid>
                    <Grid Background="#171B22" Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Skeleton Video Debugger" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <Button Content="Open Debugger Window" Click="OpenSkeletonDebuggerButton_Click"
                                    MinHeight="38" HorizontalAlignment="Left" />
                            <TextBlock x:Name="SkeletonDebuggerStatusText"
                                       Text="Every skeleton frame is saved while perception runs."
                                       Foreground="#9DA6B8"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Row="2" Margin="0,16,0,0" Background="#0F1115"
                                BorderBrush="#2B313D" BorderThickness="1" Padding="12">
                            <TextBlock Foreground="#9DA6B8" TextWrapping="Wrap"
                                       Text="The old embedded Debug Lab view is intentionally removed. Use the separate debugger window for full-size playback, zoomable timeline, frame stepping, event jumps, and frame inspection." />
                        </Border>
                    </Grid>
                    <Grid Visibility="Collapsed" Background="#101319">
                    <local:SkeletonVideoDebugView x:Name="SkeletonVideoDebugView" />
                    <ScrollViewer Visibility="Collapsed" Background="#171B22" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="112" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="150" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="70" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="124" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="96" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Back" Click="DebugStepBackButton_Click" MinHeight="30" Padding="8,4" />
                                <Button x:Name="DebugPlayPauseButton" Content="Play" Click="DebugPlayPauseButton_Click" MinHeight="30" Padding="8,4" />
                                <Button Content="Next" Click="DebugStepForwardButton_Click" MinHeight="30" Padding="8,4" />
                                <Button x:Name="ClassifierDebugRecordButton" Content="Live" Click="ClassifierDebugRecordButton_Click" MinHeight="30" Padding="8,4" />
                                <CheckBox x:Name="PauseDebugCheckBox" Content="Freeze" Foreground="#E7EAF0" Margin="0,6,8,0" />
                                <Button Content="Export" Click="ExportDebugButton_Click" MinHeight="30" Padding="8,4" />
                                <Button Content="Clear" Click="ClearDebugButton_Click" MinHeight="30" Padding="8,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="78">
                                <TextBlock Text="Gesture Timeline" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="DebugStateText" Text="Live follow" Foreground="#9DA6B8" TextWrapping="NoWrap" />
                                <TextBlock x:Name="DebugRecordText" Text="No debug frames captured yet" Foreground="#9DA6B8" TextWrapping="NoWrap" />
                                <Slider x:Name="DebugFrameSlider" Minimum="0" Maximum="0" ValueChanged="DebugFrameSlider_ValueChanged" Margin="0,6,8,0" />
                                <TextBlock x:Name="DebugSelectionText" Text="-" Foreground="#9DA6B8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <ListBox x:Name="DebugScoresList" Grid.Row="1" Background="#0F1115" Foreground="#E7EAF0" />

                        <TextBlock Grid.Row="2" x:Name="GesturePlaybackText" Text="Recorded hand skeleton playback" Foreground="#9DA6B8" Margin="0,10,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Row="3" Background="#050608" BorderBrush="#2B313D" BorderThickness="1">
                            <Canvas x:Name="GesturePlaybackCanvas" Height="146" ClipToBounds="True" />
                        </Border>

                        <TextBlock Grid.Row="4" Text="Session Timeline" Foreground="#9DA6B8" Margin="0,10,0,4" />
                        <Border Grid.Row="5" Background="#050608" BorderBrush="#2B313D" BorderThickness="1">
                            <Canvas x:Name="DebugTimelineCanvas" Height="66" ClipToBounds="True" />
                        </Border>

                        <TextBlock Grid.Row="6" Text="Selected Raw Skeleton" Foreground="#9DA6B8" Margin="0,10,0,4" />
                        <Border Grid.Row="7" Background="#050608" BorderBrush="#2B313D" BorderThickness="1">
                            <Canvas x:Name="DebugSkeletonCanvas" Height="114" ClipToBounds="True" />
                        </Border>

                        <TextBlock Grid.Row="8" Text="Recognizer 2s Window" Foreground="#9DA6B8" Margin="0,10,0,4" />
                        <Border Grid.Row="9" Background="#050608" BorderBrush="#2B313D" BorderThickness="1">
                            <Canvas x:Name="DebugMatchCanvas" Height="88" ClipToBounds="True" />
                        </Border>

                        <TextBlock Grid.Row="10" Text="Candidate and Template Paths" Foreground="#9DA6B8" Margin="0,10,0,4" />
                        <Border Grid.Row="11" Background="#050608" BorderBrush="#2B313D" BorderThickness="1">
                            <Canvas x:Name="DebugPathCanvas" Height="92" ClipToBounds="True" />
                        </Border>

                        <DockPanel Grid.Row="12" Margin="0,10,0,4">
                            <CheckBox x:Name="DebugRawVectorsCheckBox" DockPanel.Dock="Right" Content="Raw" IsChecked="True" Foreground="#E7EAF0" />
                            <TextBlock x:Name="DebugCandidateText" Text="No candidate vector" Foreground="#9DA6B8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <ListBox x:Name="DebugVectorList" Grid.Row="13" Background="#0F1115" Foreground="#E7EAF0" />
                    </Grid>
                    </ScrollViewer>
                    </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
