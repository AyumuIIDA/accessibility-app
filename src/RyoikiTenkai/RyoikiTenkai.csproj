<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="models\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <NativeInferenceBackend Condition="'$(NativeInferenceBackend)' == ''">qnn</NativeInferenceBackend>
  </PropertyGroup>

  <ItemGroup Condition="'$(NativeInferenceBackend)' == 'qnn'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.QNN" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativeInferenceBackend)' == 'directml'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

</Project>
